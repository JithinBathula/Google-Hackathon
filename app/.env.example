# Copy to .env (gitignored). Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Google OAuth client (Google Auth Platform -> Clients), for the leaver's Drive and Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where this app is reachable; the OAuth callback is BASE_URL/auth/google/callback
BASE_URL=http://localhost:8080
# The demo story's "today". Leave empty for the real date.
STORY_TODAY=2026-10-09
